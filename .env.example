# ============================================================
# NSP Backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Server (USED) ---
# HTTP port for the Express server. Defaults to 3000 if unset.
PORT=3000

# --- Application (RESERVED) ---
# Not read by any code yet; will be used once environment
# switching (dev/staging/prod) lands.
NODE_ENV=development

# --- PostgreSQL database (RESERVED) ---
# Not read by any code yet. Will be consumed by
# src/config/db.js when the database layer is implemented (SRS
# Section 8: one shared database, schema-per-module).
# Multi-AZ RDS PostgreSQL in production (FR-INF-03).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nsp
DB_USER=nsp_app
DB_PASSWORD=change-me

# --- AWS (RESERVED) ---
# Not read yet. Will be needed by src/config/aws.js for S3
# pre-signed upload URLs (FR-CAND-02) and AES-256 media storage
# (FR-INF-04).
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_MEDIA=

# --- Auth / JWT (RESERVED) ---
# Not read yet. Required when real token issuance lands
# (FR-AUTH-02: RS256-signed 15-min access tokens + rotating
# refresh tokens).
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ACCESS_TTL=15m

# --- Blockchain (RESERVED) ---
# Not read yet. Will be needed by the ledger module for the
# Polygon L2 RPC endpoint and the pre-funded gas wallet
# (FR-LEDG-03, FR-CHAIN-07). Amoy testnet for pilot/staging.
# POLYGON_RPC_URL=
# GAS_WALLET_ADDRESS=
