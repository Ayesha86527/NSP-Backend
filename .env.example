# NSP Backend - LOCAL DEVELOPMENT template. Copy to .env and fill in.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Then:  npm run keys:generate   and   npm run check:env

NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nsp
DB_USER=nsp_app
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# ---- Security ----
# 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# >= 32 chars:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CNIC_DEDUP_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
RATE_LIMIT_PER_MINUTE=60
# RS256 keys come from:  npm run keys:generate   (writes src/config/keys/)

# ---- AWS S3 ----
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nsp-dev-bucket

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Blockchain (Polygon Amoy) ----
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CERTIFICATE_LOGIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# NOTE the spelling: RELAYER (not RELATER). Testnet-only wallet!
RELAYER_PRIVATE_KEY=0x<64-hex-characters>
MIN_GAS_THRESHOLD=1

DEVICE_ONLINE_THRESHOLD_SECONDS=300
