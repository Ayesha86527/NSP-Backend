# NSP Backend - PRODUCTION environment template.
# Copy to the deployment secret store (or .env on the host), fill every value,
# and NEVER commit the filled-in file. The server refuses to start if any
# value below is missing or malformed (see src/config/validateEnv.js).

NODE_ENV=production
PORT=3000
# One reverse proxy (e.g. AWS ALB) in front of the API. Required for correct per-client rate limiting.
TRUST_PROXY=1

# ---- PostgreSQL (AWS RDS) -------------------------------------------------
DB_HOST=<rds-endpoint>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nsp
DB_USER=nsp_app
DB_PASSWORD=<from-secret-manager>
# Mandatory in production; certificates are verified (do NOT set DB_SSL_REJECT_UNAUTHORIZED=false)
DB_SSL=true
DB_SSL_CA=/etc/nsp/rds-global-bundle.pem
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# ---- Security ------------------------------------------------------------
# 64 hex chars (32 bytes). Rotating this invalidates every stored MFA secret.
MFA_ENCRYPTION_KEY=<64-hex-characters>
# >= 32 characters. Changing this breaks CNIC duplicate detection.
CNIC_DEDUP_SECRET=<at-least-32-random-characters>
# HTTPS origins of the Issuer Portal and Verifier DApp only
CORS_ALLOWED_ORIGINS=https://issuer.example.gov.pk,https://verify.example.gov.pk
RATE_LIMIT_PER_MINUTE=60
# RS256 keys must be mounted at src/config/keys/private.key and public.key (file mode 0400)

# ---- AWS S3 --------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<nsp-media-bucket>
# No access keys here: attach an IAM role with s3:PutObject on the bucket.

# ---- Redis (ElastiCache) --------------------------------------------------
REDIS_URL=rediss://<elasticache-endpoint>:6379

# ---- Blockchain (Polygon Amoy testnet) -------------------------------------
POLYGON_AMOY_RPC_URL=https://<provider>/<api-key>
CERTIFICATE_LOGIC_CONTRACT_ADDRESS=0x<deployed-CertificateLogic-address>
# Pre-funded relayer wallet. Store in a secret manager, never in source control.
RELAYER_PRIVATE_KEY=0x<64-hex-characters>
MIN_GAS_THRESHOLD=1

# RS256 key directory (mounted secret). Default: src/config/keys
JWT_KEYS_DIR=/etc/nsp/keys
